{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-builder:execution_record:2",
  "title": "execution_record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "assessment_ref": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "external_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "account_ref": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "parameter_hash": {
      "type": "string",
      "minLength": 1
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "prepared",
        "submitted",
        "running",
        "succeeded",
        "failed",
        "unknown",
        "cancelled"
      ]
    },
    "side_effecting": {
      "type": "boolean"
    },
    "business_verification": {
      "enum": [
        "not_checked",
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "verification_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retry_allowed": {
      "type": "boolean"
    },
    "reconciliation_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deduplication_guarantee": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "workflow_ref",
    "assessment_ref",
    "request_id",
    "attempt",
    "external_job_id",
    "account_ref",
    "action",
    "parameter_hash",
    "authorization_ref",
    "status",
    "side_effecting",
    "business_verification",
    "verification_evidence_refs",
    "retry_allowed",
    "reconciliation_evidence_refs",
    "deduplication_guarantee",
    "next_action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "business_verification": {
            "const": "passed"
          }
        },
        "required": [
          "business_verification"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "succeeded"
          },
          "verification_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          },
          "side_effecting": {
            "const": true
          }
        },
        "required": [
          "status",
          "side_effecting"
        ]
      },
      "then": {
        "properties": {
          "retry_allowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attempt": {
            "minimum": 2
          },
          "side_effecting": {
            "const": true
          }
        },
        "required": [
          "attempt",
          "side_effecting"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "reconciliation_evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "deduplication_guarantee": {
                "const": true
              }
            }
          }
        ]
      }
    }
  ]
}
