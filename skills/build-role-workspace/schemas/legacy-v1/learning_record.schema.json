{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-builder:learning_record:2",
  "title": "learning_record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "learning_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "included_sample_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "excluded_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sample_ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sample_ref",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "comparability_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "data_quality_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "candidate_explanation": {
      "type": "string",
      "minLength": 1
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "counterexample_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "basis_type": {
      "enum": [
        "observation",
        "expert_preference",
        "company_policy",
        "statistical_association",
        "causal_evidence"
      ]
    },
    "proposed_rule_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "under_review",
        "approved_for_knowledge",
        "inconclusive",
        "rejected"
      ]
    },
    "expert_decision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_ref": {
              "type": "string",
              "minLength": 1
            },
            "decided_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "actor_id",
            "decision_ref",
            "decided_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "feedback_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "learning_id",
    "project_id",
    "question",
    "included_sample_refs",
    "excluded_samples",
    "comparability_conditions",
    "data_quality_issues",
    "observation",
    "candidate_explanation",
    "alternative_explanations",
    "counterexample_refs",
    "missing_evidence",
    "basis_type",
    "proposed_rule_ref",
    "status",
    "expert_decision",
    "validation_refs",
    "feedback_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved_for_knowledge"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "expert_decision": {
            "type": "object",
            "properties": {
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1
              },
              "decided_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actor_id",
              "decision_ref",
              "decided_at"
            ],
            "additionalProperties": false
          },
          "validation_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "proposed_rule_ref": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
