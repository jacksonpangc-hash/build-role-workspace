{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-builder:project_state:2",
  "title": "project_state",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "role_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "enum": [
        "intake",
        "workflow_mapping",
        "rule_elicitation",
        "sample_calibration",
        "working_result",
        "workflow_acceptance",
        "automation_assessment",
        "automation_build",
        "completed_manual",
        "completed_assisted",
        "ready_for_scoped_run"
      ]
    },
    "business_workflow": {
      "type": "object",
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "drafting",
            "trial",
            "accepted"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "normal_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "handoff": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptance": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "decided_at": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "actor_id",
                "decision_ref",
                "decided_at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workflow_id",
        "version",
        "status",
        "scope",
        "step_ids",
        "normal_path",
        "exceptions",
        "handoff",
        "evidence_refs",
        "acceptance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "acceptance": {
                "type": "object",
                "properties": {
                  "actor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decided_at": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "actor_id",
                  "decision_ref",
                  "decided_at"
                ],
                "additionalProperties": false
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "handoff": {
                "type": "string",
                "minLength": 1
              },
              "step_ids": {
                "minItems": 1
              },
              "normal_path": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "statement",
          "source_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authorization_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "tenant_id",
    "role_ids",
    "revision",
    "stage",
    "business_workflow",
    "confirmed_facts",
    "assumptions",
    "open_questions",
    "decisions",
    "artifact_refs",
    "authorization_refs",
    "next_action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "automation_assessment",
              "automation_build",
              "completed_manual",
              "completed_assisted",
              "ready_for_scoped_run"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "business_workflow": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "business_workflow": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "business_workflow"
        ]
      },
      "then": {
        "properties": {
          "role_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
