{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-builder:annotation:2",
  "title": "annotation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "properties": {
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sample_id",
        "source_id",
        "source_version",
        "object_type"
      ],
      "additionalProperties": false
    },
    "rule_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "answer_state": {
      "enum": [
        "known",
        "unknown",
        "not_applicable"
      ]
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean",
        "array",
        "null"
      ]
    },
    "basis": {
      "enum": [
        "observed",
        "derived",
        "expert_judgment",
        "reported_outcome"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "video",
              "document",
              "table",
              "system",
              "user_statement"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "evidence_id",
          "source_id",
          "source_version",
          "kind",
          "locator",
          "description"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "video"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "start_seconds",
                "end_seconds"
              ]
            }
          }
        ]
      },
      "minItems": 0
    },
    "origin": {
      "enum": [
        "ai",
        "deterministic",
        "human",
        "imported"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "suggested",
        "needs_review",
        "accepted",
        "rejected",
        "unknown"
      ]
    },
    "acceptance_mode": {
      "enum": [
        "none",
        "human_reviewed",
        "auto_under_policy"
      ]
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "uncertainty_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_annotation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "annotation_id",
    "project_id",
    "subject",
    "rule_ref",
    "answer_state",
    "value",
    "basis",
    "evidence",
    "origin",
    "model_version",
    "prompt_version",
    "status",
    "acceptance_mode",
    "reviewer_id",
    "reviewed_at",
    "policy_ref",
    "uncertainty_reason",
    "previous_annotation_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "answer_state": {
            "const": "unknown"
          }
        },
        "required": [
          "answer_state"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "status": {
            "const": "unknown"
          },
          "acceptance_mode": {
            "const": "none"
          },
          "uncertainty_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answer_state": {
            "const": "not_applicable"
          }
        },
        "required": [
          "answer_state"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answer_state": {
            "const": "known"
          }
        },
        "required": [
          "answer_state"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "not": {
              "type": "null"
            }
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "acceptance_mode": {
            "enum": [
              "human_reviewed",
              "auto_under_policy"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "suggested",
              "needs_review",
              "rejected",
              "unknown"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "acceptance_mode": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "acceptance_mode": {
            "const": "human_reviewed"
          }
        },
        "required": [
          "acceptance_mode"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "accepted"
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "acceptance_mode": {
            "const": "auto_under_policy"
          }
        },
        "required": [
          "acceptance_mode"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "accepted"
          },
          "policy_ref": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "reviewer_id": {
            "type": "null"
          },
          "reviewed_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "ai"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "prompt_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "answer_state": {
            "const": "unknown"
          }
        }
      }
    }
  ]
}
