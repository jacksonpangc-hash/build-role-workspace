{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-builder:task_result:2",
  "title": "task_result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "status": {
      "enum": [
        "draft",
        "partial",
        "ready_for_review",
        "accepted",
        "blocked"
      ]
    },
    "retrieval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "filters": {
              "type": "object",
              "properties": {
                "tenant_id": {
                  "type": "string",
                  "minLength": 1
                },
                "role_id": {
                  "type": "string",
                  "minLength": 1
                },
                "rule_status": {
                  "enum": [
                    "active",
                    "exploratory"
                  ]
                },
                "time_scope": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "tenant_id",
                "role_id",
                "rule_status",
                "time_scope"
              ],
              "additionalProperties": false
            },
            "rule_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "counterexample_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "no_answer": {
              "type": "boolean"
            }
          },
          "required": [
            "query",
            "filters",
            "rule_refs",
            "counterexample_refs",
            "no_answer"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "statement",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric_rule_ref": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "known": {
            "type": "boolean"
          }
        },
        "required": [
          "metric_rule_ref",
          "source_refs",
          "expression",
          "value",
          "unit",
          "known"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "known": {
                  "const": true
                }
              },
              "required": [
                "known"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "known": {
                  "const": false
                }
              },
              "required": [
                "known"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "feedback_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "external_run_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_ref": {
              "type": "string",
              "minLength": 1
            },
            "decided_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "actor_id",
            "decision_ref",
            "decided_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "goal",
    "constraints",
    "status",
    "retrieval",
    "facts",
    "calculations",
    "recommendations",
    "unresolved",
    "artifact_refs",
    "feedback_refs",
    "external_run_refs",
    "acceptance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "acceptance": {
            "type": "object",
            "properties": {
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1
              },
              "decided_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actor_id",
              "decision_ref",
              "decided_at"
            ],
            "additionalProperties": false
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    }
  ]
}
