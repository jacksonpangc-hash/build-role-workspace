{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-builder:evaluation_record:2",
  "title": "evaluation_record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "rule_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "dataset_ref": {
      "type": "string",
      "minLength": 1
    },
    "split_description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "actual_output_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "label_or_scenario": {
            "type": "string",
            "minLength": 1
          },
          "numerator": {
            "type": "integer",
            "minimum": 0
          },
          "denominator": {
            "type": "integer",
            "minimum": 0
          },
          "unknown_count": {
            "type": "integer",
            "minimum": 0
          },
          "sampling_description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "label_or_scenario",
          "numerator",
          "denominator",
          "unknown_count",
          "sampling_description"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "executed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "evaluation_id",
    "scope",
    "rule_refs",
    "dataset_ref",
    "split_description",
    "status",
    "actual_output_refs",
    "findings",
    "metrics",
    "reviewer_id",
    "executed_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_run"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "actual_output_refs": {
            "maxItems": 0
          },
          "metrics": {
            "maxItems": 0
          },
          "executed_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "actual_output_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "executed_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
